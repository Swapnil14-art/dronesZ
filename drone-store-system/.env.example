# ====================================================================
# Supabase PostgreSQL Database & API Gateway Configuration Template
# ====================================================================
# Note: Spring Boot JPA/Hibernate & Flyway require direct PostgreSQL JDBC connection credentials.
# HTTP API keys (SUPABASE_ANON_KEY / SUPABASE_SECRET_KEY) cannot replace JDBC socket connections.

#APIs Listing   :   http://localhost:8070/swagger-ui.html

# Direct / Pooler PostgreSQL JDBC Connection (Required by JPA & Flyway)
DB_HOST=db.your-project-ref.supabase.co
DB_PORT=6543
DB_NAME=postgres
DB_USERNAME=postgres
DB_PASSWORD=your_supabase_db_password_here
DB_URL=jdbc:postgresql://${DB_HOST}:${DB_PORT}/${DB_NAME}?sslmode=require

# Supabase API Gateway Configuration
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your_supabase_public_anon_key_here
SUPABASE_SECRET_KEY=your_supabase_service_role_secret_key_here

# Spring Boot Server Configuration
SERVER_PORT=8070

# Security & JWT Configuration (Must be at least 256-bit / 32-character secret)
JWT_SECRET=your_base64_or_hex_encoded_secret_key_minimum_256_bits_here
JWT_EXPIRATION_MS=86400000

# Frontend API Configuration
VITE_API_BASE_URL=http://localhost:8070
NEXT_PUBLIC_API_BASE_URL=https://your-backend-url.com

# Redis URL (Local development default; Render production uses the REDIS_URL environment variable)
REDIS_URL=redis://localhost:6379

# ====================================================================
# Resend Email Delivery Configuration
# ====================================================================
# Resend API key (e.g. re_123456789)
RESEND_API_KEY=your_resend_api_key_here
# Administrator recipient inbox for enquiries
ADMIN_EMAIL=sales@dronesz.in
CONTACT_TO_EMAIL=sales@dronesz.in
# Verified sender header (e.g. "DronesZ Enquiries <sales@dronesz.in>" or onboarding@resend.dev)
RESEND_FROM="DronesZ Enquiries <onboarding@resend.dev>"

# ====================================================================
# Rate Limiting & Abuse Controls
# ====================================================================
# Max form submissions per IP per 15-minute window
RATE_LIMIT_MAX=10
